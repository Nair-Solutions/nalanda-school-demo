# Public base URL used for canonical links, sitemap and Open Graph.
# Set to the production domain once it is connected (e.g. https://www.nalandakurud.in).
NEXT_PUBLIC_SITE_URL=

# --- Enquiry form delivery (configure ONE option; never commit real values) ---

# Option A: email via Resend (https://resend.com)
RESEND_API_KEY=
# Address that receives enquiries (must be confirmed by the school)
ENQUIRY_TO_EMAIL=
# Verified sender, e.g. "Nalanda Website <enquiries@your-verified-domain>"
ENQUIRY_FROM_EMAIL=

# Option B: JSON webhook (e.g. a Google Apps Script web app that appends to a Sheet)
ENQUIRY_WEBHOOK_URL=
# Shared secret sent in the X-Enquiry-Secret header so the webhook can reject other callers
ENQUIRY_WEBHOOK_SECRET=

# Optional: enquiries allowed per IP per 10 minutes (default 5). Only raise it for automated tests.
ENQUIRY_RATE_LIMIT=
